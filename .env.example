# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/secure_file_sharing

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption Configuration
ENCRYPTION_KEY_PATH=secret.key

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Application Configuration
APP_NAME=Secure Cloud File Sharing System
APP_VERSION=1.0.0
DEBUG=True

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute

# Blockchain Integration (OPTIONAL)
# Set to true to enable blockchain anchoring of file hashes
BLOCKCHAIN_ENABLED=false

# Web3 Provider URL (Ganache local dev: http://127.0.0.1:8545)
WEB3_PROVIDER_URL=http://127.0.0.1:8545

# Ethereum Private Key (64 hex characters, with or without 0x prefix)
# Example: 0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# SECURITY: Never commit real private keys to version control!
PRIVATE_KEY=

# Smart Contract Address (42 characters: 0x + 40 hex chars)
# Example: 0x1234567890123456789012345678901234567890
CONTRACT_ADDRESS=
